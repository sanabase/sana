  Future<void> _loadMedications() async {
    SanaStore.instance.ensureScope(
      _currentSanaScopeKey(_client),
    );

    if (mounted) {
      setState(() {
        _rows = <Map<String, dynamic>>[];
      });
    }

    if (!mounted) return;
    if (SanaStore.instance.isLoaded) {
      setState(() {
        _medicationsList = SanaStore.instance.rows('medications');
      });
      return;
    }
    if (!mounted) return;
    try {
      final currentUser = _client.auth.currentUser;
      if (currentUser == null) {
        throw StateError('No Supabase Auth session exists.');
      }

      final query = _client.from('medications').select();
      final dynamic response = currentUser.isAnonymous
          ? await query.eq('guest_id', currentUser.id)
          : await query.eq('user_id', currentUser.id);

      final List<dynamic> list = response as List<dynamic>;
      final List<Map<String, dynamic>> records = _dedupeRecordRows(
        list
            .map((item) => Map<String, dynamic>.from(item as Map))
            .toList(),
      );

      if (mounted) {
        setState(() {
          _medicationsList = records;
        });
      }
    } catch (_) {
      if (mounted) {
        setState(() {
          _medicationsList = [];
        });
      }
    }
  }

  Future<void> _load() async {
    if (mounted) {
      setState(() {
        _rows = <Map<String, dynamic>>[];
      });
    }

    if (!mounted) return;
    if (SanaStore.instance.isLoaded) {
      final local = SanaStore.instance.rows(_table);
      setState(() { _rows = local; _loading = false; });
      if (_table == 'reminders' && widget.remindersEnabled) {
        for (final row in local) {
          try { await SanaAlarmService.scheduleReminder(row); } catch (_) {}
        }
      }
      return;
    }
    if (!mounted) return;

    // ADD THESE 5 LINES FOR DEBUG
    //print('========== LOAD ==========');
    //print('Type: ${widget.type}');
    //print('Table: $_table');
    //print('Owner ID: ${widget.ownerId}');
    //print('Guest Mode: ${widget.guestMode}');

    try {
      final tableName = _table;
      final currentUser = _client.auth.currentUser;
      if (currentUser == null) {
        throw StateError('No Supabase Auth session exists.');
      }

      final query = _client.from(tableName).select();
      final dynamic response = currentUser.isAnonymous
          ? await query.eq('guest_id', currentUser.id)
          : await query.eq('user_id', currentUser.id);

      if (mounted) {
        final List<dynamic> list = response as List<dynamic>;
        var records = _dedupeRecordRows(
          list
              .map((item) => Map<String, dynamic>.from(item as Map))
              .toList(),
        );

        // ADD THIS 1 LINE FOR DEBUG
        print('Records found: ${records.length}');

        setState(() {
          _rows = records;
          _loading = false;
        });

if (_table == 'reminders' && widget.remindersEnabled) {
          for (final row in records) {
            try {
              await SanaAlarmService.scheduleReminder(row);
            } catch (e) {
              debugPrint(
                'Reminder alarm scheduling failed for ${row['id']}: $e',
              );
            }
          }
        }
      }
    } catch (e) {
      if (mounted) {
        setState(() => _loading = false);
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('Error loading: $e')));
      }
    }
  }

