                                                                .grey.shade600),
                                                      ),
                                                    ],
                                                  ),
                                                ),
                                              ),
                                      ),
                                      DataCell(
                                        Text(
                                          active
                                              ? tr(
                                                  language,
                                                  'active_user',
                                                )
                                              : tr(
                                                  language,
                                                  'inactive_guest',
                                                ),
                                        ),
                                      ),
                                      DataCell(
                                        ElevatedButton(
                                          onPressed: isAdmin
                                              ? null
                                              : () => _setActive(
                                                    u,
                                                    !active,
                                                  ),
                                          child: Text(
                                            active
                                                ? tr(
                                                    language,
                                                    'deactivate',
                                                  )
                                                : tr(
                                                    language,
                                                    'activate',
                                                  ),
                                          ),
                                        ),
                                      ),
                                      DataCell(
                                        isAdmin
                                            ? const SizedBox.shrink()
                                            : IconButton(
                                                icon: const Icon(
                                                  Icons.delete_outline,
                                                  color: Colors.redAccent,
                                                  size: 22,
                                                ),
                                                tooltip: tr(
                                                  language,
                                                  'delete',
                                                ),
                                                onPressed: () => _deleteUser(u),
                                              ),
                                      ),
                                    ],
                                  );
                                }).toList(),
                              ),
                            ),
                          ),
                        ),
                      ),
                    );
                  },
                ),
        ),
      ),
    );
  }
}



