        audioAttributesUsage: AudioAttributesUsage.alarm,
        ongoing: true,
        playSound: true,
        enableVibration: false,
        fullScreenIntent: true,
        autoCancel: false,
        actions: [
          AndroidNotificationAction(
            'taken',
            tr(
