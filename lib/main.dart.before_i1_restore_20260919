                                    final times = SanaAlarmService.parseTimes(
                                      row['reminder_time'],
                                    );

                                    if (times.isEmpty) {
                                      return 24 * 60;
                                    }

                                    var earliest = 24 * 60;

                                    for (final time in times) {
                                      final parts = time.split(':');

                                      if (parts.length < 2) {
